{
  "id": "io.github.anil_e.Codd",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "command": "codd",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--device=dri",
    "--socket=wayland",
    "--socket=ssh-auth",
    "--filesystem=~/.pgpass:ro"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_NET_OFFLINE": "true"
    }
  },
  "modules": [
    {
      "name": "codd",
      "buildsystem": "meson",
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/anil-e/codd.git",
          "tag": "v0.14.0",
          "commit": "26020ae44ab2a58c0a4dcf8dec3c0058861715a5"
        },
        "cargo-sources.json"
      ],
      "config-opts": ["-Dcargo-home=/run/build/codd/cargo"]
    }
  ]
}
